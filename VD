--==================================================
-- SKILL CHECK LOOP
--==================================================

local PreviousVisible = false

RunService.RenderStepped:Connect(function()

    if not AutoGeneratorOn then

        PreviousVisible = false
        return
    end

    if not Check
    or not Check.Parent then

        RefreshGeneratorReferences()
    end

    if not Check then
        return
    end

    local Visible =
        Check.Visible

    -- Skill Check เปิดใหม่
    if Visible and not PreviousVisible then

        GeneratorBusy = false

        if not ScourgeActive then

            if GeneratorMode == "INSTANT" then
                InstantNormal()
            end

        end
    end

    PreviousVisible = Visible

    -- SUCCESS / NEUTRAL
    if Visible and not ScourgeActive then

        if not GeneratorBusy then

            local ShouldTrigger = false

            if GeneratorMode == "SUCCESS" then

                ShouldTrigger =
                    IsSuccess()

            elseif GeneratorMode == "NEUTRAL" then

                ShouldTrigger =
                    IsNeutral()

            end

            if ShouldTrigger then

                GeneratorBusy = true

                TriggerGeneratorAction()

                task.delay(
                    0.07,
                    function()
                        GeneratorBusy = false
                    end
                )

            end
        end
    end

    -- SCOURGE
    if ScourgeActive and Visible then

        if GeneratorMode == "SUCCESS" then

            if not GeneratorBusy
            and IsSuccess() then

                GeneratorBusy = true

                TriggerGeneratorAction()

                task.delay(
                    0.06,
                    function()
                        GeneratorBusy = false
                    end
                )

            end

        elseif GeneratorMode == "NEUTRAL" then

            if not GeneratorBusy
            and IsNeutral() then

                GeneratorBusy = true

                TriggerGeneratorAction()

                task.delay(
                    0.06,
                    function()
                        GeneratorBusy = false
                    end
                )

            end
        end
    end
end)

--==================================================
-- INSTANT LOOP
-- FIX NEAR GENERATOR END
--==================================================

task.spawn(function()

    local LastGoalRotation = nil
    local LastCheckState = false

    while task.wait(0.01) do

        if AutoGeneratorOn
        and GeneratorMode == "INSTANT" then

            if not Check
            or not Check.Parent
            or not Goal
            or not Line then

                RefreshGeneratorReferences()
            end

            if Check
            and Check.Visible
            and Goal
            and Line then

                local CurrentGoal =
                    tonumber(Goal.Rotation) or 0

                -- Skill Check ใหม่
                if not LastCheckState then

                    LastCheckState = true
                    LastGoalRotation =
                        CurrentGoal

                    if ScourgeActive then
                        InstantScourge()
                    else
                        InstantNormal()
                    end

                -- Goal เปลี่ยน
                elseif LastGoalRotation == nil
                or math.abs(
                    CurrentGoal
                    - LastGoalRotation
                ) > 1 then

                    LastGoalRotation =
                        CurrentGoal

                    if ScourgeActive then
                        InstantScourge()
                    else
                        InstantNormal()
                    end
                end

            else

                -- Skill Check หายแล้ว
                -- พร้อมรับรอบถัดไป
                LastCheckState = false
                LastGoalRotation = nil

            end

        else

            LastCheckState = false
            LastGoalRotation = nil

        end
    end
end)

