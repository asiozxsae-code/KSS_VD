local ORANGE = Color3.fromRGB(255,140,0)
local RED = Color3.fromRGB(255,50,50)
local GREEN = Color3.fromRGB(50,255,80)

--==================================================
-- CREATE ESP
--==================================================

local function createESP(object,color)

    if not object then
        return
    end

    if object:FindFirstChild("ZERO_ESP") then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ZERO_ESP"
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.65
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = object
    highlight.Parent = object
end

--==================================================
-- REMOVE ESP
--==================================================

local function removeESP()

    for _,object in ipairs(workspace:GetDescendants()) do

        local esp = object:FindFirstChild("ZERO_ESP")

        if esp then
            esp:Destroy()
        end
    end

    for _,plr in ipairs(Players:GetPlayers()) do

        if plr.Character then

            local esp = plr.Character:FindFirstChild("ZERO_ESP")

            if esp then
                esp:Destroy()
            end
        end
    end
end

--==================================================
-- GENERATOR
--==================================================

local function isGenerator(object)

    local name = string.lower(object.Name)

    return string.find(name,"generator")
        or string.find(name,"gen")
        or string.find(name,"เครื่องปั่น")
end

--==================================================
-- ROLE
--==================================================

local function getPlayerColor(plr)

    if plr == player then
        return nil
    end

    if plr.Team then

        local teamName = string.lower(plr.Team.Name)

        if string.find(teamName,"killer")
        or string.find(teamName,"murderer")
        or string.find(teamName,"ฆาตกร") then
            return RED
        end

        if string.find(teamName,"survivor")
        or string.find(teamName,"survive")
        or string.find(teamName,"ผู้เอาชีวิต") then
            return GREEN
        end
    end

    local role = plr:GetAttribute("Role")

    if typeof(role) == "string" then

        role = string.lower(role)

        if string.find(role,"killer")
        or string.find(role,"murderer")
        or string.find(role,"ฆาตกร") then
            return RED
        end

        if string.find(role,"survivor")
        or string.find(role,"survive")
        or string.find(role,"ผู้เอาชีวิต") then
            return GREEN
        end
    end

    return nil
end

--==================================================
-- UPDATE ESP
--==================================================

local function updateESP()

    if not ESPOn then
        return
    end

    for _,plr in ipairs(Players:GetPlayers()) do

        local character = plr.Character

        if character then

            local color = getPlayerColor(plr)

            if color then
                createESP(character,color)
            end
        end
    end

    for _,object in ipairs(workspace:GetDescendants()) do

        if object:IsA("Model") or object:IsA("BasePart") then

            if isGenerator(object) then
                createESP(object,ORANGE)
            end
        end
    end
end

