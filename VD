--==================================================
-- ACTION
--==================================================

local function TriggerGeneratorAction()

    if not Action
    or not Action.Parent then

        RefreshGeneratorReferences()
    end

    if not Action then
        return false
    end

    local now = os.clock()

    if now - LastTrigger < TriggerDelay then
        return false
    end

    LastTrigger = now

    pcall(function()

        if Action:IsA("GuiButton") then
            Action:Activate()
        end

    end)

    if typeof(firesignal) == "function" then

        pcall(function()

            if Action.MouseButton1Down then
                firesignal(
                    Action.MouseButton1Down
                )
            end

        end)
    end

    return true
end

--==================================================
-- ANGLE
--==================================================

local function GetAngle()

    if not Line or not Goal then
        return nil
    end

    return
        tonumber(Line.Rotation) or 0,
        tonumber(Goal.Rotation) or 0
end

local function IsSuccess()

    local LineRotation,GoalRotation =
        GetAngle()

    if not LineRotation then
        return false
    end

    local Min =
        GoalRotation + SUCCESS_MIN

    local Max =
        GoalRotation + SUCCESS_MAX

    return
        LineRotation >= Min
        and LineRotation <= Max
end

local function IsNeutral()

    local LineRotation,GoalRotation =
        GetAngle()

    if not LineRotation then
        return false
    end

    local Min =
        GoalRotation + NEUTRAL_MIN

    local Max =
        GoalRotation + NEUTRAL_MAX

    return
        LineRotation > Min
        and LineRotation <= Max
end

--==================================================
-- INSTANT NORMAL
--==================================================

local function InstantNormal()

    if not Check
    or not Line
    or not Goal then

        RefreshGeneratorReferences()
    end

    if not Check
    or not Line
    or not Goal then
        return
    end

    if not Check.Visible then
        return
    end

    local GoalRotation =
        tonumber(Goal.Rotation) or 0

    Line.Rotation =
        GoalRotation + 109

    TriggerGeneratorAction()
end

--==================================================
-- INSTANT SCOURGE
--==================================================

local function InstantScourge()

    if not AutoGeneratorOn then
        return
    end

    if not ScourgeActive then
        return
    end

    if not Line or not Goal then
        RefreshGeneratorReferences()
    end

    if not Line or not Goal then
        return
    end

    local GoalRotation =
        tonumber(Goal.Rotation) or 0

    Line.Rotation =
        GoalRotation + 109

    TriggerGeneratorAction()

    ScourgeRound += 1
end

