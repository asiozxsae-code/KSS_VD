--==================================================
-- LIGHTING
--==================================================

local function Brightness()
    Lighting.Brightness = 2.5
    Lighting.ExposureCompensation = 0.8
    Lighting.Ambient = Color3.fromRGB(130,130,130)
    Lighting.OutdoorAmbient = Color3.fromRGB(150,150,150)
    Lighting.ColorShift_Top = Color3.fromRGB(235,235,235)
    Lighting.ColorShift_Bottom = Color3.fromRGB(220,220,220)
    Lighting.ClockTime = 14
end

local function NoFog()
    Lighting.FogStart = 100000
    Lighting.FogEnd = 100000

    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Atmosphere") then
            obj.Density = 0
            obj.Haze = 0
            obj.Glare = 0
        end
    end
end

--==================================================
-- ESP
--==================================================

local ESPObjects = {}

local RED = Color3.fromRGB(255,60,60)
local GREEN = Color3.fromRGB(60,255,100)
local ORANGE = Color3.fromRGB(255,170,0)

local function createESP(object, color)

    if not object or not object.Parent then
        return
    end

    if ESPObjects[object] then
        ESPObjects[object].FillColor = color
        ESPObjects[object].OutlineColor = color
        return
    end

    local highlight = Instance.new("Highlight")

    highlight.Name = "ZERO_ESP"
    highlight.Adornee = object
    highlight.FillColor = color
    highlight.FillTransparency = 0.65
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = object

    ESPObjects[object] = highlight
end

local function removeESP(object)

    local esp = ESPObjects[object]

    if esp then
        pcall(function()
            esp:Destroy()
        end)

        ESPObjects[object] = nil
    end
end

local function clearESP()

    for object, esp in pairs(ESPObjects) do

        pcall(function()
            esp:Destroy()
        end)

        ESPObjects[object] = nil
    end
end

local function isGenerator(object)

    local name = string.lower(object.Name)

    return string.find(name, "generator")
        or string.find(name, "เครื่องปั่น")
end

local function getPlayerColor(player)

    local role = player:GetAttribute("Role")

    if role then

        role = string.lower(tostring(role))

        if string.find(role, "killer")
        or string.find(role, "murderer")
        or string.find(role, "ฆาตกร") then
            return RED
        end

        if string.find(role, "survivor")
        or string.find(role, "survive")
        or string.find(role, "ผู้รอดชีวิต") then
            return GREEN
        end
    end

    local team = player.Team

    if team then

        local teamName = string.lower(team.Name)

        if string.find(teamName, "killer")
        or string.find(teamName, "murderer")
        or string.find(teamName, "ฆาตกร") then
            return RED
        end

        if string.find(teamName, "survivor")
        or string.find(teamName, "survive")
        or string.find(teamName, "ผู้รอดชีวิต") then
            return GREEN
        end
    end

    return GREEN
end

local function updatePlayerESP()

    if not ESPOn then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer then

            local character = player.Character

            if character and character.Parent then
                createESP(
                    character,
                    getPlayerColor(player)
                )
            end
        end
    end
end

local function updateGeneratorESP()

    if not ESPOn then
        return
    end

    for _, object in ipairs(workspace:GetDescendants()) do

        if isGenerator(object) then

            local model =
                object:FindFirstAncestorOfClass("Model")

            if model then

                local player =
                    Players:GetPlayerFromCharacter(model)

                if not player then
                    createESP(object, ORANGE)
                end

            else
                createESP(object, ORANGE)
            end
        end
    end
end

task.spawn(function()

    while task.wait(0.5) do

        if ESPOn then
            updatePlayerESP()
        end

    end
end)

task.spawn(function()

    while task.wait(3) do

        if ESPOn then
            updateGeneratorESP()
        end

    end
end)

--==================================================
-- PLAYER EVENTS
--==================================================

local function setupPlayer(player)

    if player == LocalPlayer then
        return
    end

    player.CharacterAdded:Connect(function()

        task.wait(1)

        if ESPOn then
            updatePlayerESP()
        end

    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(player)

    if player.Character then
        removeESP(player.Character)
    end

end)

--==================================================
-- NOCLIP
--==================================================

local function setNoclip(state)
    NoclipOn = state
end

RunService.Stepped:Connect(function()

    if not NoclipOn then
        return
    end

    local character = LocalPlayer.Character

    if character then

        for _, part in ipairs(character:GetDescendants()) do

            if part:IsA("BasePart") then
                part.CanCollide = false
            end

        end
    end
end)

--==================================================
-- THIRD PERSON
--==================================================

local function setThirdPerson(state)

    ThirdPersonOn = state

    if state then

        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        LocalPlayer.CameraMinZoomDistance = 5
        LocalPlayer.CameraMaxZoomDistance = 20

    else

        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.CameraMaxZoomDistance = 20

    end
end

