-- KSS VD | Script Selector
-- เลือกสคริปต์แล้วเมนูจะลบตัวเองทันที
-- Script 1 / Script 2 โหลดจาก GitHub Raw

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local SCRIPT_1 = "https://raw.githubusercontent.com/asiozxsae-code/KSS_VD/refs/heads/main/KSS%20VD%201"
local SCRIPT_2 = "https://raw.githubusercontent.com/asiozxsae-code/KSS_VD/refs/heads/main/KSS%20VD%20(BETA)"

local gui = Instance.new("ScreenGui")
gui.Name = "KSS_VD_ScriptSelector"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = PlayerGui

local frame = Instance.new("Frame")
frame.Name = "Selector"
frame.AnchorPoint = Vector2.new(0.5, 0.5)
frame.Position = UDim2.fromScale(0.5, 0.5)
frame.Size = UDim2.fromOffset(330, 190)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 16)
corner.Parent = frame

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(190, 30, 50)
stroke.Thickness = 1.5
stroke.Transparency = 0.2
stroke.Parent = frame

local title = Instance.new("TextLabel")
title.BackgroundTransparency = 1
title.Size = UDim2.new(1, -30, 0, 45)
title.Position = UDim2.fromOffset(15, 12)
title.Font = Enum.Font.GothamBold
title.Text = "KSS VD"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 22
title.Parent = frame

local sub = Instance.new("TextLabel")
sub.BackgroundTransparency = 1
sub.Size = UDim2.new(1, -30, 0, 24)
sub.Position = UDim2.fromOffset(15, 48)
sub.Font = Enum.Font.Gotham
sub.Text = "เลือกสคริปต์ที่ต้องการใช้งาน"
sub.TextColor3 = Color3.fromRGB(170, 170, 175)
sub.TextSize = 13
sub.Parent = frame

local function makeButton(text, y, callback)
    local b = Instance.new("TextButton")
    b.AutoButtonColor = true
    b.Size = UDim2.new(1, -30, 0, 48)
    b.Position = UDim2.fromOffset(15, y)
    b.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    b.BorderSizePixel = 0
    b.Font = Enum.Font.GothamSemibold
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.TextSize = 14
    b.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = b

    b.MouseButton1Click:Connect(callback)
    return b
end

local busy = false

local function runSelected(url)
    if busy then
        return
    end

    busy = true
    title.Text = "กำลังโหลด..."
    sub.Text = "กำลังเปิดสคริปต์ที่เลือก"

    for _, child in ipairs(frame:GetChildren()) do
        if child:IsA("TextButton") then
            child.Active = false
            pcall(function()
                child.Interactable = false
            end)
        end
    end

    -- ลบตัวเลือกออกก่อน แล้วจึงโหลดเฉพาะสคริปต์ที่เลือก
    gui:Destroy()

    local okHttp, source = pcall(function()
        return game:HttpGet(url)
    end)

    if not okHttp then
        warn("KSS VD Script Selector: โหลด GitHub ไม่สำเร็จ: " .. tostring(source))
        return
    end

    local fn, compileErr = loadstring(source)
    if not fn then
        warn("KSS VD Script Selector: Compile Error: " .. tostring(compileErr))
        return
    end

    local okRun, runErr = pcall(fn)
    if not okRun then
        warn("KSS VD Script Selector: Runtime Error: " .. tostring(runErr))
    end
end

makeButton("Script 1  •  KSS VD", 80, function()
    runSelected(SCRIPT_1)
end)

makeButton("Script 2  •  KSS VD BETA", 135, function()
    runSelected(SCRIPT_2)
end)
